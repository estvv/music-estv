{
  "name": "music-estv-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "create-admin": "if [ -d src ]; then tsx src/scripts/create-admin.ts; else node dist/scripts/create-admin.js; fi",
    "db:fixtures": "if [ -d src ]; then tsx src/scripts/fixtures.ts; else node dist/scripts/fixtures.js; fi"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "ws": "^8.22.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/node": "^24.12.3",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.18.2",
    "supertest": "^7.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.4.5",
    "vitest": "^3.0.5"
  }
}
