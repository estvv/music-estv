# Copy to .env (gitignored) and fill in. docker compose reads it automatically.

# Public origin of the site, no trailing slash. Must match the Spotify redirect
# URI registered in the Spotify dashboard: ${PUBLIC_URL}/api/spotify/callback
PUBLIC_URL=https://music.example.org

# PostgreSQL password (the `db` container). Local dev: `music` matches the
# backend's default DATABASE_URL, so host-side npm scripts and tests work as is.
# Production: a long random value, `openssl rand -hex 24`.
POSTGRES_PASSWORD=music

# Admin account created by `npm run db:fixtures` (password generated and printed).
ADMIN_USERNAME=admin
ADMIN_DISPLAY_NAME=Admin

# 32 random bytes in hex, encrypts Spotify tokens at rest: `openssl rand -hex 32`
# Changing it later invalidates every Spotify link (users just re-link).
TOKEN_ENCRYPTION_KEY=

# From https://developer.spotify.com/dashboard (optional: without them, Spotify
# features are hidden and everything runs on Deezer).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
